node_modules

# real environment values (see .env.example for the template)
.env
.env.local

# lesson PDFs written by the local storage driver
#
# The leading slash anchors this to server/storage: an unanchored
# "storage" also matches server/shared/storage, which holds the storage
# driver's own source (index.js, localDriver.js, signUrl.js,
# supabaseDriver.js) and must be committed.
/storage/

# Scratch scripts and their output from driving the live API by hand
# (server/.e2e). The login files there hold real session tokens for the
# admin and student accounts, so this directory must never be committed.
.e2e/
