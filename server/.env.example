# Copy this file to server/.env and fill in the values.

# MongoDB connection (database_password is substituted into Database_URL)
Database_URL=mongodb+srv://user:<DB_PASSWORD>@cluster.example.mongodb.net/dbname
database_password=change-me

# Secret used to sign login tokens
JWT_SECRET=change-me
# Optional: JWT_EXPIRES_IN=1d (the login cookie expires with it)

# Optional: how far the login cookie may travel. The server picks
# SameSite=None in production (needed when the client and the API are on
# different sites; browsers then also require Secure) and SameSite=Lax
# otherwise. Set COOKIE_SAME_SITE=lax when both run on the same site: the
# cookie then stops riding along on cross-site requests entirely.
# COOKIE_SAME_SITE=lax

# Origin of the web client, used for CORS (credentials are allowed, so
# this must be exact -- no trailing slash).
CLIENT_URL=http://localhost:5173

# Google Gemini, used by the student AI chat (required to boot the server)
GEMINI_API_KEY=change-me
# Optional: GEMINI_MODEL=gemini-2.5-flash-lite

# Google YouTube Data API v3. Optional: when set, AI chat
# recommendations become real, embeddable videos. When missing or
# failing, recommendations fall back to YouTube search-result links.
YOUTUBE_API_KEY=

# ---- Object storage for lesson PDFs ------------------------------------
# Which driver stores the PDF files:
#   local      the filesystem (no account needed; handy for development)
#   supabase   Supabase Storage, served to students as signed urls
STORAGE_DRIVER=supabase

# local driver only: where files are written, and the origin signed file
# urls are built from. Leave PUBLIC_API_URL empty when the API is served
# from the same origin as the site (the Vite dev proxy does exactly that).
# STORAGE_LOCAL_DIR=./storage
# PUBLIC_API_URL=

# Optional: secret used to sign local file urls. Falls back to JWT_SECRET.
# STORAGE_SIGNING_SECRET=

# ---- Supabase Storage (needed when STORAGE_DRIVER=supabase) -------------
# Create the bucket in the Supabase dashboard first. It can stay private:
# students receive short-lived signed urls, so nothing is made public.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to 'lesson-materials'
# SUPABASE_STORAGE_BUCKET=lesson-materials


# Optional: PORT=5000
